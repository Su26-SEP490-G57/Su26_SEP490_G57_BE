# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=SEP490_G57
DB_SCHEMA=SEP490_G57

# TypeORM
DB_HOST=localhost
DB_PORT=5432
DB_SYNC=false
DB_LOGGING=false

# App
PORT=3000
NODE_ENV=production

# Firebase Admin (service account)
# Set these three values to configure Firebase admin from environment. The private key
# is often provided as a base64-encoded value to avoid multiline env entries.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_BASE64=
